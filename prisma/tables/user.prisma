model User {
  id       String  @id @default(ulid())
  name     String
  email    String? @unique
  phone    String  @unique
  password String

  role     UserRole @default(CUSTOMER)
  isActive Boolean  @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}
