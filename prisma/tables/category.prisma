model Category {
  id            String  @id @default(ulid())
  name          String  @unique
  slug          String  @unique
  description   String?
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}
